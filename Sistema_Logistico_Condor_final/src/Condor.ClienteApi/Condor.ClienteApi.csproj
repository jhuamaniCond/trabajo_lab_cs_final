    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Condor.ClienteApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Condor.Dominio\Condor.Dominio.csproj" />
  </ItemGroup>

</Project>
