<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cliente HTTP de Condor.Api (CC-01): implementa los repositorios de
       Condor.Dominio.Contratos llamando al backend, para que las PC del
       mostrador no se conecten directamente a PostgreSQL. Sin WPF, para
       probarlo contra la API en memoria. -->
