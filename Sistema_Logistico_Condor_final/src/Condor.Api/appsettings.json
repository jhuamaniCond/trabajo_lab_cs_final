{
  // Backend REST del Sistema de Ventas Cóndor (CC-01). Ver docs/api.md.
  "Urls": "http://0.0.0.0:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Misma base de datos central que las PC del mostrador (condor.json).
  // 5433 = contenedor Cas_condor de ejecutar.ps1.
  "BaseDatos": {
    "Servidor": "localhost",
    "Puerto": 5433,
    "BaseDatos": "condor",
    "Usuario": "condor_app",
    "Clave": "condor_local",
    "TiempoEsperaSegundos": 5,
    "MaxConexiones": 20
  },

  // Respaldo manual (HU-15): carpeta del disco externo conectado a esta PC y,
  // si pg_dump no está en el PATH, su ruta completa. Vacío: no se generan respaldos.
  "Respaldo": {
    "Carpeta": "",
    "PgDump": "",
    "AvisoHoras": 24
  },

  // Firma de los tokens de acceso. En el local, cambiar la Clave por una
  // cadena aleatoria de al menos 32 caracteres (o definir Jwt__Clave).
  "Jwt": {
    "Emisor": "CondorVentas",
    "Audiencia": "CondorVentas",
    "Clave": "solo-desarrollo-cambiar-esta-clave-en-el-local-2026",
    "MinutosValidez": 480
  }
}
