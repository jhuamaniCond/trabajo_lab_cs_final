<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Backend REST (CC-01): expone en HTTP las mismas reglas y repositorios que
       usa la app de escritorio, con ingreso por JWT y permisos por rol. Lo usan
       las integraciones y las pruebas de rendimiento con JMeter (G8). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Condor.Api</RootNamespace>
    <AssemblyName>CondorApi</AssemblyName>
    <Version>1.2.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Condor.Datos\Condor.Datos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las pruebas de integración levantan la API en memoria (WebApplicationFactory). -->
    <InternalsVisibleTo Include="Condor.Pruebas" />
  </ItemGroup>

</Project>
