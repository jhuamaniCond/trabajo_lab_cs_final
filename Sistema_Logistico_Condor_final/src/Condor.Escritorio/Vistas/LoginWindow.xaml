<Window x:Class="Condor.Escritorio.Vistas.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingresar - Ferretería Cóndor Majes"
        Icon="/Recursos/condor.png"
        AutomationProperties.AutomationId="VentanaIngresar"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Superficie}"
        FocusManager.FocusedElement="{Binding ElementName=CampoUsuario}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}" />
    </Window.InputBindings>

    <!-- CC-01: usuario y contraseña antes de abrir Nueva venta. Los x:Name son
         también los AutomationId que usan las pruebas de interfaz (G9). -->
    <StackPanel>
        <Border Height="13" Background="{StaticResource Greca}" />

        <StackPanel Margin="28,26,28,8" HorizontalAlignment="Center">
            <Image Source="/Recursos/condor.png" Width="96" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Ferretería Cóndor" Style="{StaticResource TituloSerif}" FontSize="26"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="Ingrese con su usuario y contraseña." Foreground="{StaticResource TextoSuave}" FontSize="13"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Margin="28,16,28,0">
            <Label Content="_Usuario" Target="{Binding ElementName=CampoUsuario}" />
            <TextBox x:Name="CampoUsuario" MaxLength="20" FontSize="15"
                     Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" />

            <Label Content="_Contraseña" Target="{Binding ElementName=CampoClave}" Margin="0,14,0,0" />
            <PasswordBox x:Name="CampoClave" MaxLength="64" FontSize="15" Height="38" Padding="10,0"
                         VerticalContentAlignment="Center" PasswordChanged="CampoClave_PasswordChanged" />
        </StackPanel>

        <!-- Credenciales incorrectas, cuenta bloqueada o sin conexión. -->
        <Border Margin="28,16,28,0" Padding="12,10" CornerRadius="8" Background="{StaticResource ErrorSuave}"
                Visibility="{Binding Error, Converter={StaticResource NuloAOculto}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE783;" Style="{StaticResource Icono}" FontSize="14"
                           Foreground="{StaticResource Error}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock x:Name="TextoError" Text="{Binding Error}" Style="{StaticResource TextoError}" Margin="0" />
            </DockPanel>
        </Border>

        <Border Margin="0,26,0,0" Padding="28,16" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BotonSalir" Content="Salir" Width="120" IsCancel="True" Command="{Binding CancelarCommand}" />
                <Button x:Name="BotonIngresar" Width="150" Margin="12,0,0,0" IsDefault="True"
                        Style="{StaticResource BotonPrincipal}" Command="{Binding IngresarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Ingresar" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
