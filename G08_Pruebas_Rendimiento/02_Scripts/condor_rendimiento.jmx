                  <stringProp name="Header.value">Bearer ${token}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Pausa de digitación 1-3 s">
              <stringProp name="ConstantTimer.delay">${__P(pausa.min,1000)}</stringProp>
              <stringProp name="RandomTimer.range">${__P(pausa.rango,2000)}</stringProp>
